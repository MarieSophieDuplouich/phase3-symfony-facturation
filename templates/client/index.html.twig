{% extends 'base.html.twig' %}

{% block title %}Client index{% endblock %}

{% block body %}

<div class="min-h-screen flex flex-col md:flex-row bg-[#f8fafc]">

    <twig:NavAside />

    <main class="flex-1 p-8 bg-[#f8fafc]">

        <div class="flex flex-row justify-between items-center mb-8">
            <h1 class="text-2xl font-semibold text-gray-900">
                Clients
            </h1>

            <a class="flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white py-2 px-4 rounded-lg transition"
                href="{{ path('app_client_new') }}">
                +
                Ajouter un client
            </a>
        </div>

        <div class="bg-white rounded-lg shadow overflow-hidden">
            <div class="overflow-x-auto">

            <table class="w-full border-collapse">

                <thead class="bg-gray-50 text-left text-sm text-gray-600">
                    <tr>
                        <th class="p-4">Nom</th>
                        <th class="p-4">Email</th>
                        <th class="p-4">Téléphone</th>
                        <th class="p-4">Adresse</th>
                        <th class="p-4">SIRET</th>
                        <th class="p-4">RIB</th>
                        <th class="p-4">Actions</th>
                    </tr>
                </thead>

                <tbody class="text-sm">

                    {% for client in clients %}
                    <tr class="border-t hover:bg-[#0D3B9E] hover:text-white transition-colors duration-200">

                        <td class="p-4">{{ client.name }}</td>
                        <td class="p-4">{{ client.email }}</td>
                        <td class="p-4">{{ client.phone }}</td>
                        <td class="p-4">{{ client.address }}</td>
                        <td class="p-4">{{ client.siret }}</td>
                        <td class="p-4">{{ client.rib }}</td>

                        <td class="p-4 flex gap-3">
                            {{ include('client/_row_actions.html.twig', {client: client}) }}
                        </td>

                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="7" class="p-6 text-center text-gray-500">
                            Aucun client trouvé
                        </td>
                    </tr>
                    {% endfor %}

                </tbody>

            </table>

            </div>
        </div>

    </main>
</div>

{% endblock %}