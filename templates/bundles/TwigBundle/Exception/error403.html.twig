{% extends 'base.html.twig' %}

{% block title %}Accès refusé (403){% endblock %}
{% block meta_description %}Vous n'avez pas les droits nécessaires pour accéder à cette page {{ app_name }}.{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#F9FAFB] font-sans flex flex-col items-center justify-center gap-6 px-4 text-center">
    <span class="text-blue-700 font-extrabold text-7xl">403</span>

    <div class="flex flex-col gap-2">
        <h1 class="text-2xl font-bold text-gray-900">Accès refusé</h1>
        <p class="text-gray-500 max-w-md">
            Vous n'avez pas les droits nécessaires pour voir cette page, ou vous devez
            vous connecter avec le bon compte.
        </p>
    </div>

    <a href="{{ path('app_dashboard') }}"
       class="px-5 py-2.5 bg-blue-700 hover:bg-blue-800 text-white rounded-lg text-sm font-medium transition">
        Retour au tableau de bord
    </a>
</div>
{% endblock %}
