{% extends 'base.html.twig' %}

{% block title %}Nouveau produit{% endblock %}

{% block body %}
<div class="min-h-screen flex flex-col md:flex-row bg-[#F9FAFB]">

    <twig:NavAside />

    <div class="flex-1 flex flex-col items-center gap-10 py-10">

        <header class="flex flex-col items-center gap-2">
            <svg width="36" height="44" viewBox="0 0 36 44" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path
                    d="M2 2V42L6 40L10 42L14 40L18 42L22 40L26 42L30 40L34 42V2L30 4L26 2L22 4L18 2L14 4L10 2L6 4L2 2Z"
                    stroke="#155DFC" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
                <path
                    d="M26 14H14C12.9391 14 11.9217 14.4214 11.1716 15.1716C10.4214 15.9217 10 16.9391 10 18C10 19.0609 10.4214 20.0783 11.1716 20.8284C11.9217 21.5786 12.9391 22 14 22H22C23.0609 22 24.0783 22.4214 24.8284 23.1716C25.5786 23.9217 26 24.9391 26 26C26 27.0609 25.5786 28.0783 24.8284 28.8284C24.0783 29.5786 23.0609 30 22 30H10"
                    stroke="#155DFC" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M18 33V11" stroke="#155DFC" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>


            <h1 class="text-2xl font-bold">Ajouter un nouveau produit</h1>

            <a href="{{ path('app_product_index') }}" class="text-[#155DFC] hover:underline">
                Retour à la liste
            </a>
        </header>

        <main class="bg-white shadow-md rounded-lg p-6 w-full max-w-xl">
            {{ include('product/_form.html.twig') }}
        </main>

        <section class="w-full max-w-5xl mt-10">
            <h2 class="text-xl font-semibold mb-4">Produits & Services existants</h2>

            <div class="overflow-x-auto bg-white shadow rounded-lg">
                <table class="w-full text-sm text-left">
                    <thead class="bg-gray-100 text-gray-700">
                        <tr>
                            <th class="p-4">Nom</th>
                            <th class="p-4">Description</th>
                            <th class="p-4">Prix</th>
                            <th class="p-4">Unité</th>
                            <th class="p-4">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        {% for product in products %}
                        <tr class="border-t hover:bg-gray-50">
                            <td class="p-4">{{ product.name }}</td>
                            <td class="p-4">{{ product.description }}</td>
                            <td class="p-4">{{ product.price }}</td>
                            <td class="p-4">{{ product.unit.value }}</td>

                            <td class="p-4 flex gap-3">
                                {{ include('product/_row_actions.html.twig', {product: product}) }}
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="5" class="p-4 text-center text-gray-500">
                                Aucun produit trouvé
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>

    </div>
</div>
{% endblock %}