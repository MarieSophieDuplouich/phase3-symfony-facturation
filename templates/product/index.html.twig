{% extends 'base.html.twig' %}

{% block title %}Product index{% endblock %}

{% block body %}

<div class="min-h-screen flex flex-col md:flex-row bg-[#f8fafc]">
 
    <twig:NavAside/>

    <main class="flex-1 p-8 bg-[#f8fafc]">
        <div class="flex flex-row flex-wrap justify-between gap-3">
            <h1 class="text-2xl font-semibold text-gray-900 mb-8">Produits & Services</h1>
            <a class="flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white py-2 px-4 rounded-lg transition"
                href="{{ path('app_product_new') }}">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M0.75 6H11.25" stroke="white" stroke-width="1.5" stroke-linecap="round"
                        stroke-linejoin="round" />
                    <path d="M6 0.75V11.25" stroke="white" stroke-width="1.5" stroke-linecap="round"
                        stroke-linejoin="round" />
                </svg>

                Ajouter un produit
            </a>
        </div>

        <div class="overflow-x-auto">
        <table class="table border-collapse border border-gray-200 ">
            <thead>
                <tr>

                    <th>Nom</th>
                    <th>Description</th>
                    <th>Prix unitaire</th>
                    <th>Unité</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for product in products %}
                <tr class="bg-white hover:bg-[#0D3B9E] hover:text-white transition-colors duration-200">

                    <td >{{ product.name }}</td>
                    <td>{{ product.description }}</td>
                    <td >{{ product.price }}</td>
                    <td >{{ product.unit.value}}</td>
                    <td class="flex flex-row gap-2">
                        {{ include('product/_row_actions.html.twig', {product: product}) }}
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="6">aucun enregistrement trouvé</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>

</div>

    </main>
</div>
{% endblock %}