{% extends 'base.html.twig' %}

{% block title %}Envoyer le mail{% endblock %}

{% block body %}

<div class="min-h-screen flex justify-center items-center bg-[#F9FAFB]">

    <div class="bg-white shadow-lg rounded-xl p-10 text-center">

        {% for message in app.flashes('success') %}
            <h1 class="text-3xl font-bold text-green-600 mb-4">
                {{ message }}
            </h1>
        {% else %}
            <h1 class="text-2xl font-bold text-gray-900 mb-4">
                Envoyer le PDF par email
            </h1>
        {% endfor %}

        <p class="text-gray-600 mb-6">
            Cliquez sur le bouton ci-dessous pour envoyer le PDF à l'adresse configurée.
        </p>

        <form method="post" action="{{ path('app_mail_send') }}" onsubmit="return confirm('Envoyer le PDF par email ?');">
            <input type="hidden" name="_token" value="{{ csrf_token('send_mail') }}">
            <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm transition-colors">
                Envoyer l'email
            </button>
        </form>

    </div>

</div>

{% endblock %}